//@version=5
indicator("Liquidity Sweep", overlay=true, max_lines_count=500)

// settings
len = input.int(5, "Swing length")
maxAge = input.int(50, "Max bars since swing")
useVol = input.bool(true, "Volume filter")
volLen = input.int(20, "Volume MA length")
volMult = input.float(1.5, "Volume multiplier")
drawLines = input.bool(true, "Draw lines")

// find swing highs and lows
ph = ta.pivothigh(high, len, len)
pl = ta.pivotlow(low, len, len)

var float swingHigh = na
var int swingHighBar = na
var float swingLow = na
var int swingLowBar = na

if not na(ph)
    swingHigh := ph
    swingHighBar := bar_index - len
if not na(pl)
    swingLow := pl
    swingLowBar := bar_index - len

// volume check
volAvg = ta.sma(volume, volLen)
volOk = not useVol or na(volume) or volume > volAvg * volMult

// sweep = wick through the level but close back inside
sweepHigh = not na(swingHigh) and bar_index - swingHighBar <= maxAge and high > swingHigh and close < swingHigh and volOk
sweepLow = not na(swingLow) and bar_index - swingLowBar <= maxAge and low < swingLow and close > swingLow and volOk

// reset level after sweep or real breakout
if sweepHigh
    if drawLines
        line.new(swingHighBar, swingHigh, bar_index, swingHigh, color=color.red, style=line.style_dashed)
    swingHigh := na
else if close > swingHigh
    swingHigh := na

if sweepLow
    if drawLines
        line.new(swingLowBar, swingLow, bar_index, swingLow, color=color.green, style=line.style_dashed)
    swingLow := na
else if close < swingLow
    swingLow := na

plotshape(sweepHigh, "Sweep high", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(sweepLow, "Sweep low", shape.triangleup, location.belowbar, color.green, size=size.small)

alertcondition(sweepHigh, "Sweep high", "Liquidity sweep above high on {{ticker}}")
alertcondition(sweepLow, "Sweep low", "Liquidity sweep below low on {{ticker}}")
